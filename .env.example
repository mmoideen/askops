# AskOps configuration. Copy to .env and fill in values.
# Never commit a filled version of this file.

# Auth (Entra ID / OIDC)
# Generate AUTH_SECRET with: npx auth secret (or openssl rand -base64 32)
AUTH_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
# Local only. Enables the dev sign in path (dev-member / dev-admin) under
# next dev. The app refuses to start if this is true in production.
AUTH_DEV_BYPASS=false

# LLM + embeddings
# LLM_PROVIDER: anthropic | mock (mock is deterministic, needs no key)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
# EMBEDDINGS_PROVIDER: local | openai (local is deterministic, needs no key)
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small

# Data
# Docker compose maps the container to host port 5433 to avoid clashing with
# any locally installed Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/askops

# Retrieval
RETRIEVER=pgvector           # pgvector | aisearch
RETRIEVAL_MIN_SIMILARITY=0.18
RETRIEVAL_TOP_K=6
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=

# Guardrails
RATE_LIMIT_PER_MINUTE=20
# memory for local dev. postgres for serverless deployments, where instances
# do not share memory.
RATE_LIMIT_STORE=memory
