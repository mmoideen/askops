# AskOps prototype configuration. Copy to .env and fill in values.

# Postgres (docker compose default)
# Docker compose maps the container to host port 5433 to avoid clashing with
# any locally installed Postgres.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/askops

# LLM. Leave ANTHROPIC_API_KEY empty to use the built in extractive fallback.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
