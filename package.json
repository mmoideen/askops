{
  "name": "askops",
  "version": "0.1.0",
  "private": true,
  "description": "AskOps: an internal knowledge assistant prototype",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
