    "@opentelemetry/semantic-conventions": "^1.43.0",
    "drizzle-orm": "0.45.4",
    "next": "15.5.28",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.0",
    "eslint-config-next": "15.5.28",
    "prettier": "^3.9.10",
